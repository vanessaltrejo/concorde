# Copy to .env.local (git-ignored) for `npm run dev`. On Vercel, set the same
# names in Project Settings > Environment Variables. Never prefix with VITE_:
# Vite would send VITE_* values to the browser.
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Routing (api/_lib/router.ts): simple questions -> AI_SIMPLE_PROVIDER,
# complex ones (compare, best, safe, requirements, why) -> AI_COMPLEX_PROVIDER.
# The other one is the fallback. AI_ROUTING=off uses AI_PROVIDER only.
# AI_ROUTING=auto
# AI_SIMPLE_PROVIDER=gemini
# AI_COMPLEX_PROVIDER=groq
# AI_PROVIDER=gemini

# Model per provider (defaults in api/_lib/provider.ts)
# AI_MODEL_GEMINI=gemini-3.5-flash-lite
# AI_MODEL_GROQ=openai/gpt-oss-120b

# AI_RATE_LIMIT_PER_HOUR=30

# Terrain tiles for "Horizon view anywhere" (public address, safe in the browser).
# Default: the gatekeeper Worker, https://concorde-terrain.emiliano-bucam.workers.dev
# VITE_TERRAIN_URL=

# Terrain tile upload (scripts/upload_tiles.py only; never read by the app).
# Cloudflare R2 > Manage API tokens > Object Read & Write, scoped to the
# concorde-terrain bucket. The Secret Access Key is shown only once.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
